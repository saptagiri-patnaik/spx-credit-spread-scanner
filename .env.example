# ---- Credentials: AWS Secrets Manager ----
# Names one secret holding a JSON object of every credential -- the DB_* set, the
# API keys, the Schwab account hash, the X bearer token and both Discord webhooks.
# When it is set, any of those left blank below is filled from the secret; anything
# you DO set here still wins, so a laptop run can be pointed at a scratch database
# without touching the shared secret.
#
# EMPTY BY DEFAULT, and that is the right default: everything below runs from this
# file alone, with no AWS account and no boto3. Naming a secret you cannot read is
# not a warning -- it is a hard failure at `import config`, on purpose, because
# silently falling back to empty credentials surfaces as a baffling auth error
# several seconds later instead.
#
# Set it to spx-scanner/prod only if you deploy to Lambda and own that secret.
# Requires boto3 locally: pip install -r requirements-dev.txt
# (Lambda sets this variable itself -- deploy/common.ps1 injects it, so the
#  deployed function does not depend on what this file says.)
#
# Push .env's credentials into the secret:  ./deploy/secrets.ps1
# List what the secret holds (names only):  ./deploy/secrets.ps1 -Show
SPX_SECRET_ID=

# ---- Database (Postgres) ----
# Two ways to configure this; pick ONE.
# If (and only if) you set SPX_SECRET_ID above, these may be left blank and come
# from the secret instead -- a blank line here means "inherit", not "empty". That
# is the intended state of this file once you have run secrets.ps1.
#
# (a) Full URL. Note you must percent-encode any special characters in the
#     password yourself (@ -> %40, # -> %23, etc.).
DATABASE_URL=postgresql+psycopg2://user:password@your-host.example.com:5432/spx
#
# (b) Separate parts. Preferred: the password is encoded for you, so awkward
#     characters just work. Setting DB_HOST makes these win over DATABASE_URL.
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=

# ---- Scoring backend ----
# ollama    = local llama3.1:8b, no API cost, ~14 min/cycle
# anthropic = hosted Claude: faster, and far better at separating index impact
#             from headline tone (the local 8B scores ~83% of everything bearish)
LLM_PROVIDER=ollama

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Only read when LLM_PROVIDER=anthropic. Leave ANTHROPIC_API_KEY unset here and
# the SDK will pick it up from the environment instead.
ANTHROPIC_API_KEY=
# claude-haiku-4-5 is the recommended start for per-item scoring: high volume,
# simple triage, cheapest per token. claude-sonnet-5 and claude-opus-5 are the
# step-ups -- grade them on your labelled eval set rather than assuming the
# expensive one wins.
ANTHROPIC_MODEL=claude-haiku-4-5
ANTHROPIC_MAX_TOKENS=512
# SDK default read timeout is 600s = the whole Lambda budget, so one hung
# call ends a cycle having done nothing. Observed 4 Aug 2026.
ANTHROPIC_TIMEOUT_SECONDS=30
SYNTHESIS_TIMEOUT_SECONDS=120

# ---- Free data source keys ----
# All optional: each collector is skipped when its key is blank.
YOUTUBE_API_KEY=
NEWSAPI_KEY=
FINNHUB_KEY=
FRED_API_KEY=

# ---- Schwab Trader API (options-chain data) ----
# Access token is refreshed by a separate program and stored in the Postgres
# `app_data` table. Leave SCHWAB_TOKEN_DB_URL blank to reuse DATABASE_URL, or
# point it at the DB that holds app_data if it lives elsewhere.
SCHWAB_TOKEN_DB_URL=
# If app_data lives in a different database on the SAME server, just name it
# here and it is assembled from the DB_* parts above.
SCHWAB_TOKEN_DB_NAME=
SCHWAB_TOKEN_KEY=access_token
SCHWAB_ACCOUNT_HASH=

# ---- X / Twitter API (pay-per-use; hard-capped by budget guard) ----
# Also set a Spending Limit of $20 in the X Developer Console as a backstop.
X_BEARER_TOKEN=
X_DAILY_POST_BUDGET=130
X_POST_UNIT_COST=0.005
X_MAX_RESULTS_PER_RUN=10
# Posts held back for the session's own cycles. The budget resets on the UTC day
# but the paid window runs to 22:00 ET, so a budget day opens by funding the
# PREVIOUS evening's post-close block, then pre-market, and only then the session
# whose predictions get recorded -- without a reserve the guard is first-come and
# a heavy news night can spend the day before the bell. Size it at one session's
# worth: (RTH cycles on your schedule) x X_MAX_RESULTS_PER_RUN. Held back before
# the open, lifted during the session, released after the close. 0 disables.
# 90 = 9 RTH cycles x the X_MAX_RESULTS_PER_RUN above; resize it whenever you
# raise that cap, or the reserve stops covering a full session.
X_MARKET_HOURS_RESERVE=90

# ---- Alerts ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Routine outlook updates (one per cycle when ALERT_ONLY_ON_TRADE=false).
DISCORD_WEBHOOK_URL=
# Actionable trade signals only. Point this at a separate channel so you can
# leave notifications on for it. Falls back to DISCORD_WEBHOOK_URL when unset.
DISCORD_TRADE_WEBHOOK_URL=
# A recommended scan repeats on every cycle the gates keep passing, so the same
# spread would otherwise alert ~9x a day and keep re-alerting a position you
# already hold. Re-announce a given spread at most once per this many hours.
TRADE_ALERT_COOLDOWN_HOURS=24

# ---- Strategy / behaviour ----
# UNDERLYING: SPX (full index, most liquid) | XSP (1/10 mini) | SPY (ETF, American-style)
UNDERLYING=SPX
INTERVAL_MINUTES=45
LOOKBACK_DAYS=7
HORIZON_DAYS=6
DTE_MIN=20
DTE_MAX=25
CONFIDENCE_GATE=0.40  # synthesis-aggregator scale (p75 of 0.30-0.42); 0.65 was the mean-aggregator scale and never opened a model-arm trade
MACRO_WEIGHT=0.5
# How close a high-impact release must be for the event-risk flag to fire, which
# is what swaps the scanner onto EVENT_RISK_DELTA_CAP / EVENT_RISK_MIN_BUFFER.
# This was DTE_MAX (25d) until 6 Aug 2026, which made it True on 190 of 190
# predictions -- permanently on, so SHORT_DELTA_MAX and MIN_BUFFER never applied.
# 4 = PAPER_HOLD_DAYS (fires for a release the position sits through): 53% of
# cycles on the banked history. 3 -> 36%, 5 -> 70%, 7 -> 95%.
EVENT_RISK_WINDOW_DAYS=4
SHORT_DELTA_TARGET=0.20
SPREAD_WIDTH=25

# ---- Spread scanner / trade timing ----
# Widths are in index points. SPX strikes are $5 apart near the money (wider far OTM),
# so 5-50 pt verticals are typical. For XSP (~1/10 price) use MIN_WIDTH=1, MAX_WIDTH=10.
SHORT_DELTA_MIN=0.10
SHORT_DELTA_MAX=0.30
MIN_WIDTH=5
MAX_WIDTH=50
MIN_CREDIT_TO_WIDTH=0.20
MIN_POP=0.68
MIN_BUFFER=0.8
MAX_REL_BID_ASK=0.6
MIN_EDGE_SCORE=0.05
ALIGN_WEIGHT=0.15
# Premium richness (IV/RV) as an edge INPUT, never a gate: days of history
# only, and a hard floor on a number that thin is how CONFIDENCE_GATE came
# to block every cycle. Ratio clamped to 0.5-1.5 before weighting.
PREMIUM_WEIGHT=0.15
REQUIRE_MARKET_HOURS=true
MARKET_TZ=America/New_York
# true  = push to Telegram/Discord only when a trade clears all three gates
# false = push every cycle, including OUTLOOK-only runs (~32 messages/day)
ALERT_ONLY_ON_TRADE=true

# ---- Full-text extraction & chunked analysis ----
FETCH_FULLTEXT=true
FULLTEXT_MAX_CHARS=20000
FULLTEXT_TIMEOUT=15
FULLTEXT_MAX_WORKERS=8
LLM_CHUNK_CHARS=6000
LLM_MAX_CHUNKS=3

# Drop items with fewer than this many words once cashtags, @mentions and URLs
# are stripped -- "$SPY $GOOG" has nothing to score but still votes in the
# aggregate. 8 removes ~31% of a typical corpus, ~97% of it social. 0 disables.
MIN_ITEM_WORDS=8

# Which per-item scoring prompt to use: current | impact | theta
# See analysis/prompts.py, and grade candidates with tools/evalset.py before
# switching -- aggregate output cannot tell a fix from a different bias.
SCORING_PROMPT=current

# ---- Self-calibration (fits the stated numbers to what happened) ----
# off    = do not settle outcomes, do not fit, record nothing
# shadow = settle, fit, log and bank -- the strategy still sees raw numbers
# apply  = corrected direction and tails reach the scan, once a fit clears
#          CALIBRATION_MIN_NEFF. Below that floor, apply behaves as shadow.
# Ships in shadow: a correction has to be watchable as a series before anything
# is allowed to depend on it. See the README's Self-calibration section.
CALIBRATION_MODE=shadow

# Independent observations needed before a fit may change anything. This counts
# EVIDENCE, not rows: predictions land every 45 minutes and are scored over
# windows days long, so 87 overlapping windows across 14 observed days deflate
# to about 3. At 8 this wants roughly a month of trading days.
CALIBRATION_MIN_NEFF=8

# How many observations of belief the shipped priors are worth. A fit backed by
# n_eff observations moves a parameter n_eff/(n_eff+strength) of the way from
# the prior to what it measured.
CALIBRATION_PRIOR_STRENGTH=10

# Hard bounds on a tail correction, however much data arrives, and on how far a
# single refit may step. Refits run every cycle; no one of them is a verdict.
CALIBRATION_MAX_FACTOR=2.0
CALIBRATION_MAX_STEP=0.25

# Width of the interval a tail is judged against. 1.96 = 95%. Widening it makes
# the calibrator MORE conservative about loosening, not less.
CALIBRATION_CONFIDENCE_Z=1.96

# Longest unobserved stretch a scored window may contain. The price series is
# only as dense as the cycles that ran with a live token, and an unobserved
# breach settles as "no breach" -- which biases every tail downward, the unsafe
# direction. 96h admits a normal weekend and rejects an outage.
CALIBRATION_MAX_GAP_HOURS=96

# ---- Paper trading (measures whether the suggestions actually pay) ----
PAPER_TRADING_ENABLED=true
PAPER_HOLD_DAYS=4          # close on time after this many days (3-5 typical)
PAPER_STOP_MULTIPLE=2.0    # close if the mark reaches this x credit received;
                           # at 2.0 a $1.00 credit stops out at $2.00 = $1.00 loss
PAPER_MAX_OPEN=5

# Control arm: sells a spread daily ignoring sentiment. Keep this on -- without
# it, P&L has nothing to be compared against, and "did it beat doing nothing
# clever?" is the question that decides whether the LLM layer earns its place.
PAPER_BASELINE_ENABLED=true
PAPER_BASELINE_DELTA=0.15
PAPER_BASELINE_SIDE=put
# Minutes after the 09:30 ET open in which the control arm may still take the
# session's entry. Inside it a failed quote is retried on the next cycle; past
# it the session is left undecided rather than entered late, because retrying
# without a bound restores the drifting entry time the session anchor removed.
PAPER_BASELINE_ENTRY_WINDOW_MINUTES=90

# continuous   = score and trade every cycle, around the clock
# market_hours = collect always (feeds rotate, items would be lost), but score,
#                predict and trade only during RTH. Weekend news is collected as
#                it publishes and scored on Monday's first cycle.
SCHEDULE_MODE=continuous

LOG_LEVEL=INFO
LOG_FILE=logs/spx_scanner.log
