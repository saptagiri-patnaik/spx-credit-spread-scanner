.env
logs/
chat-history/
# Generated eval samples: regenerable, and they embed scraped article text.
eval/*.jsonl
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
*.egg-info/
build/
# Local Claude Code config (permission allowlist for the deploy scripts).
# Untracked rather than shared: build-zip.ps1 stamps a build -dirty from
# `git status --porcelain`, which counts untracked files, so leaving this
# floating would mark every deployment irreproducible.
.claude/
# Standalone HTML review artifacts (architecture/roadmap/tracker dashboards).
# Not part of the deployed source -- build-zip.ps1's manifest never lists
# this directory -- so tracking it would only add more untracked-file noise
# to the same -dirty check .claude/ above is exempted from.
artifacts/
